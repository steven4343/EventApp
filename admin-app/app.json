{
  "expo": {
    "name": "CUZ Events Admin",
    "slug": "cuz-events-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cuz-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/cuz-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/cuz-logo.png"
    }
  }
}
